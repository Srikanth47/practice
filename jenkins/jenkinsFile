pipeline {
    agent any
    parameters {
        string(name: 'GIT_REPO', defaultValue: 'https://github.com/Srikanth47/practice.git', description: 'GitHub Repository URL')
        choice(name: 'FILE_SELECTION', choices: ['Select a file'], description: 'Choose a file from the repository')
        choice(name: 'topic_operation', choices: ['create_topic', 'delete_topic', 'update_partition'], description: 'Choose an operation to perform')
    }
    stages {
        stage('Fetch Files') {
            steps {
                script {
                    // Clone the GitHub repository
                    dir('practice') {
                        checkout([$class: 'GitSCM',
                                  branches: [[name: '*/main']], // Adjust branch as needed
                                  userRemoteConfigs: [[url: params.GIT_REPO]]])
                    }
                    
                    // Get the list of files from the repository
                    def files = sh(script: "cd practice/g_vars && find . -type f | sed 's|^./||'", returnStdout: true).trim().split('\n')

                    // Retain existing parameters while updating the FILE_SELECTION dropdown
                    properties([
                        parameters([
                            string(name: 'GIT_REPO', defaultValue: 'https://github.com/Srikanth47/practice.git', description: 'GitHub Repository URL'),
                            choice(name: 'FILE_SELECTION', choices: files.join('\n'), description: 'Choose a file from the repository'),
                            choice(name: 'topic_operation', choices: ['create_topic', 'delete_topic', 'update_partition'], description: 'Choose an operation to perform')
                        ])
                    ])
                }
            }
        }
        stage('Process File') {
            steps {
                script {
                    echo "You selected: ${params.FILE_SELECTION}"
                    def selectedFilePath = "practice/g_vars/${params.FILE_SELECTION}"
                    echo "Processing file: ${selectedFilePath}"

                    // Evaluate the selected operation
                    def topic_opr
                    if (params.topic_operation == 'create_topic') {
                        topic_opr = "cluster_name=${selectedFilePath} create_topic=true"
                        echo "Create Topic Command: ${topic_opr}"
                    } else if (params.topic_operation == 'delete_topic') {
                        topic_opr = "cluster_name=${selectedFilePath} delete_topic=true"
                        echo "Delete Topic Command: ${topic_opr}"
                    } else if (params.topic_operation == 'update_partition') {
                        topic_opr = "cluster_name=${selectedFilePath} update_partition=true"
                        echo "Update Partition Command: ${topic_opr}"
                    } else {
                        echo "Invalid selection"
                    }
                    echo "Srikanth almost achieved: ${topic_opr}"

                    // Trigger next build job and pass `topic_opr`
                    build job: 'Next-Build-Job', parameters: [
                        string(name: 'TOPIC_OPERATION_DETAILS', value: topic_opr)
                    ]
                }
            }
        }
    }
