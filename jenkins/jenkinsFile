pipeline {
    agent any
     parameters {
        string(name: 'GIT_REPO', defaultValue: 'https://github.com/Srikanth47/practice.git', description: 'GitHub Repository URL')
        choice(name: 'FILE_SELECTION', choices: [], description: 'Choose a file from the repository')
        // choice(name: 'FILE_SELECTION', choices: ['create_topic', 'delete_topic', 'update_partition'], description: 'Choose a file from the repository')
    }
    stages {
        stage('Fetch Files') {
            steps {
                script {
                    // Clone the GitHub repository
                    dir('practice') {
                        checkout([$class: 'GitSCM',
                                  branches: [[name: '*/main']], // Adjust branch as needed
                                  userRemoteConfigs: [[url: params.GIT_REPO]]])
                    }
                    
                    // Get the list of files from the repository
                    def files = sh(script: "cd practice/g_vars && find . -type f | sed 's|^./||'", returnStdout: true).trim().split('\n')

                    // Update the dropdown choices dynamically
                    properties([
                        parameters([
                            choice(name: 'FILE_SELECTION', choices: files.join('\n'), description: 'Choose a file from the repository')
                        ])
                    ])
                }
            }
        }
        stage('Process File') {
            steps {
                echo "You selected: ${params.FILE_SELECTION}"
                script {
                    // Process the selected file
                    def selectedFilePath = "practice/g_vars${params.FILE_SELECTION}"
                    echo "Processing file: ${selectedFilePath}"
                    // Evaluate the selected option
                    if (params.topic_operation == 'create_topic') {
                        def create_topic = "cluster_name=${selectedFilePath} create_topic=true"
                    } else if (params.topic_operation == 'delete_topic') {
                        def delete_topic = "cluster_name=${selectedFilePath} delete_topic=true"
                    } else if (params.topic_operation == 'update_partition') {
                        def update_partition = "cluster_name=${selectedFilePath} update_partition=true"
                        echo "You selected option 3: Printing condition for 3"
                    } else {
                        echo "Invalid selection"
                    }

                    echo "topic file: ${create_topic}"
                    echo "delete_topic file: ${delete_topic}"
                    echo "update_partition file: ${update_partition}"
                }
            }
        }
    }
}
